{
  "name": "info-midpass-bot",
  "version": "0.2.0",
  "author": "Shiriakov Aleksandr <kisspeeker@icloud.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "backup": "node scripts/tgcloud-backup.mjs",
    "restore": "node scripts/tgcloud-restore.mjs",
    "deploy": "tgcloud push && node scripts/tgcloud-sync-settings.mjs && tgcloud webhook sync && tgcloud run endpoints/setup '{\"action\":\"configureBot\"}'",
    "poll": "tgcloud run endpoints/poll",
    "status": "tgcloud status",
    "run": "tgcloud run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tgcloud/cli": "^0.2.0",
    "eslint": "^10.13.0"
  },
  "packageManager": "pnpm@12.15.0"
}
